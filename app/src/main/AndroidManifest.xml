<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- "Nearest stop" for the shuttle screen; requested at runtime, and the
         screen works unranked without it. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
      Android 11（API 30）起，`resolveActivity()` / `queryIntentActivities()`
      只会返回 **对调用方可见** 的包。若不声明 <queries>，即使微信已安装也一律
      返回 null —— 表现就是「明明装了微信，却总是弹系统分享面板」。
      `startActivity()` 本身不受限制，受限的只有「查询」，所以这里只影响探测
      与择优，不会让分享彻底失效。
    -->
    <queries>
        <package android:name="com.tencent.mm" />
        <package android:name="com.tencent.wework" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.SustechMobile">

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <activity
            android:name=".ui.LoginActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <activity
            android:name=".ui.ecard.RechargeActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout" />

        <activity
            android:name=".ui.ServiceActivity"
            android:exported="true"
            android:label="@string/app_name" />

        <activity
            android:name=".ui.ServicePortalActivity"
            android:exported="false"
            android:label="@string/portal_web_title" />

        <activity
            android:name=".ui.pms.UploadActivity"
            android:exported="false"
            android:label="@string/upload_title" />

        <!-- Home-screen widget: config activity must be exported so the
             launcher can start it when the user drops the widget. -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:label="@string/widget_config_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.QuickAccessWidgetConfigActivity"
            android:exported="true"
            android:label="@string/widget_shortcuts_config_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.InfoWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_provider" />
        </receiver>

        <receiver
            android:name=".widget.CampusCardWidgetProvider"
            android:exported="false"
            android:label="@string/widget_shortcuts_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_campus_card_provider" />
        </receiver>
    </application>
</manifest>
