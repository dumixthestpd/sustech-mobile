<?xml version="1.0" encoding="utf-8"?>
<!-- Configurable 2x2 grid of quick campus shortcuts. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="150dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_ecard"
    android:previewLayout="@layout/widget_ecard"
    android:widgetCategory="home_screen"
    android:configure="edu.sustech.mobile.widget.QuickAccessWidgetConfigActivity"
    android:description="@string/widget_shortcuts_description" />
