<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="18dp">
    <TextView android:id="@+id/widget_shortcuts_config_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="18sp"
        android:textStyle="bold" />
    <TextView android:id="@+id/widget_shortcuts_config_hint" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:textColor="@color/ink_muted" android:textSize="12sp" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:text="@string/widget_shortcut_slot_1"
        android:textColor="@color/ink_muted" android:textSize="12sp" />
    <Spinner android:id="@+id/widget_shortcut_select_1" android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="@string/widget_shortcut_slot_2"
        android:textColor="@color/ink_muted" android:textSize="12sp" />
    <Spinner android:id="@+id/widget_shortcut_select_2" android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="@string/widget_shortcut_slot_3"
        android:textColor="@color/ink_muted" android:textSize="12sp" />
    <Spinner android:id="@+id/widget_shortcut_select_3" android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="@string/widget_shortcut_slot_4"
        android:textColor="@color/ink_muted" android:textSize="12sp" />
    <Spinner android:id="@+id/widget_shortcut_select_4" android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:orientation="horizontal">
        <Button android:id="@+id/widget_cancel" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/widget_cancel" />
        <Button android:id="@+id/widget_save" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/widget_save" />
    </LinearLayout>
</LinearLayout>
