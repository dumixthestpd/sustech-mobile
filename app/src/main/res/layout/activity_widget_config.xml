<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_config_title"
        android:textColor="@color/ink"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_config_hint"
        android:textColor="@color/ink_muted"
        android:textSize="12sp" />

    <RadioGroup
        android:id="@+id/widget_kinds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/widget_kind_bus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_kind_bus" />

        <RadioButton
            android:id="@+id/widget_kind_bb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_kind_bb" />

        <RadioButton
            android:id="@+id/widget_kind_classes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_kind_classes" />

        <RadioButton
            android:id="@+id/widget_kind_weather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_kind_weather" />

    </RadioGroup>

    <TextView
        android:id="@+id/widget_stops_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/widget_stops_label"
        android:textColor="@color/ink_muted"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/widget_stops"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_cancel" />

        <Button
            android:id="@+id/widget_save"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_save" />
    </LinearLayout>
</LinearLayout>
