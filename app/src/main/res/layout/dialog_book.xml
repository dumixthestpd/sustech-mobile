<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/book_room"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/rooms_book_day"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary" />

        <Spinner
            android:id="@+id/book_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/rooms_book_start"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary" />

        <TextView
            android:id="@+id/book_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textSize="16sp"
            tools:text="14:30"
            xmlns:tools="http://schemas.android.com/tools" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/rooms_book_length"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary" />

        <Spinner
            android:id="@+id/book_length"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/book_topic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/rooms_book_topic"
            android:inputType="text"
            android:maxLength="40"
            android:importantForAutofill="no" />

        <TextView
            android:id="@+id/book_members_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary"
            android:visibility="gone"
            tools:text="共同申请人学号（至少 2 人，逗号分隔）"
            xmlns:tools="http://schemas.android.com/tools" />

        <EditText
            android:id="@+id/book_members"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLength="200"
            android:importantForAutofill="no"
            android:visibility="gone" />

        <TextView
            android:id="@+id/book_policy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />
    </LinearLayout>
</ScrollView>
