<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="5dp" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeWidth="1dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
  <TextView android:id="@+id/room_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/ink" android:maxLines="1" android:ellipsize="end" />
  <TextView android:id="@+id/room_where" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textSize="11sp" android:textColor="@color/ink_muted" android:maxLines="2" android:ellipsize="end" />
  <TextView android:id="@+id/room_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/paper_tag" android:textSize="11sp" android:textStyle="bold" />
  <TextView android:id="@+id/room_schedule" android:layout_width="match_parent" android:layout_height="32dp" android:layout_marginTop="4dp" android:gravity="end|center_vertical" android:text="@string/rooms_schedule_view" android:textColor="@color/brand" android:textSize="11sp" />
 </LinearLayout>
</com.google.android.material.card.MaterialCardView>
